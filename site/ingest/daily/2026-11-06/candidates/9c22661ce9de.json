      },
      {
        "id": "E6",
        "kind": "body",
        "text": "Cloud tasks on your GitHub Copilot subscription : Run Copilot in isolated cloud environments through Air Teams, from your IDE or browser.",
        "sourceUrl": "https://github.blog/changelog/2026-11-03-github-copilot-is-now-available-in-jetbrains-air",
        "source": "GitHub Changelog",
        "publishedAt": "2026-11-03T15:11:46.000Z",
