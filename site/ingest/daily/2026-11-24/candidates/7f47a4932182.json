      {
        "id": "E2",
        "kind": "body",
        "text": "Skip to main content Over the past few months, we've been developing Enterprise Frontier Safeguards (EFS) for our business customers.",
        "sourceUrl": "https://claude.com/resources/articles/zero-data-retention-with-enterprise-frontier-safeguards",
        "source": "Claude (claude.com articles)",
