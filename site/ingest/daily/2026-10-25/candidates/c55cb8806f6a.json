      },
      {
        "id": "E8",
        "kind": "body",
        "text": "Meeting duration limits: Speech translation is available for up to 90 minutes per meeting for eligible base Workspace and Google AI Pro plans, and up to 8 hours per meeting for AI Expanded Access, AI Ultra Access, and Google AI Ultra plans.",
        "sourceUrl": "https://workspaceupdates.googleblog.com/2026/10/real-time-speech-translation-in-google-Meet-expands-to-63-languages-with-automatic-language-detection.html",
