      },
      {
        "id": "E7",
        "kind": "body",
        "text": "Meeting access and direct calls: Speech translation is available to all meeting participants, including guests from other domains, when the meeting is organized by a user with an eligible Google Workspace or Google AI plan.",
        "sourceUrl": "https://workspaceupdates.googleblog.com/2026/10/real-time-speech-translation-in-google-Meet-expands-to-63-languages-with-automatic-language-detection.html",
        "source": "Google Workspace Updates",
