        "id": "E5",
        "kind": "body",
        "text": "We’ve received our first response from the Project Suncatcher prototype satellite.",
        "sourceUrl": "https://blog.google/innovation-and-ai/models-and-research/google-research/project-suncatcher-satellite-response/",
        "source": "Google (The Keyword · AI)",
