      {
        "id": "E2",
        "kind": "body",
        "text": "We&rsquo;re open sourcing Replica, an AI-powered prototyping tool created by GitHub Design that helps anyone on your product team turn ideas into interactive prototypes using your own design system.",
        "sourceUrl": "https://github.blog/changelog/2026-10-28-introducing-replica-an-open-source-ai-prototyping-tool",
        "source": "GitHub Changelog",
        "publishedAt": "2026-10-28T15:30:00.000Z",
        "checkedAt": "2026-10-30T16:43:02.845Z"
      },
      {
        "id": "E3",
        "kind": "body",
        "text": "Music: &ldquo;Electrodoodle&rdquo; by Kevin MacLeod ( incompetech.com ), licensed under CC BY 4.0 .",
        "sourceUrl": "https://github.blog/changelog/2026-10-28-introducing-replica-an-open-source-ai-prototyping-tool",
        "source": "GitHub Changelog",
        "publishedAt": "2026-10-28T15:30:00.000Z",
