      {
        "id": "E2",
        "kind": "body",
        "text": "NVIDIA intentionally designs GPUs, CPUs, networking, storage and software together to get more useful work out of memory at every layer of the AI factory.",
        "sourceUrl": "https://blogs.nvidia.com/blog/memory-full-stack-codesign/",
        "source": "NVIDIA Blog",
