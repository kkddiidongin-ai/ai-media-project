      },
      {
        "id": "E10",
        "kind": "body",
        "text": "Applying NVFP4 to the KV cache reduces its footprint compared with FP8, so more context can stay resident in HBM.",
        "sourceUrl": "https://blogs.nvidia.com/blog/memory-full-stack-codesign/",
        "source": "NVIDIA Blog",
        "publishedAt": "2026-11-05T16:00:00.000Z",
