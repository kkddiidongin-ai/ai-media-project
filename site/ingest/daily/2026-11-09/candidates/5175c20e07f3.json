      },
      {
        "id": "E3",
        "kind": "body",
        "text": "Set up Agent Merge directly from a pull request to have Copilot merge it when it&rsquo;s ready.",
        "sourceUrl": "https://github.blog/changelog/2026-11-06-github-copilot-weekly-releases-november-2",
        "source": "GitHub Changelog",
        "publishedAt": "2026-11-06T21:00:26.000Z",
        "checkedAt": "2026-11-08T16:39:48.854Z"
      },
      {
        "id": "E4",
        "kind": "body",
        "text": "You can also check reviewer status, request additional reviews, and select comment text to quote it or discuss it with Copilot.",
        "sourceUrl": "https://github.blog/changelog/2026-11-06-github-copilot-weekly-releases-november-2",
        "source": "GitHub Changelog",
        "publishedAt": "2026-11-06T21:00:26.000Z",
        "checkedAt": "2026-11-08T16:39:48.854Z"
      },
      {
        "id": "E5",
        "kind": "body",
        "text": "Introducing a new way to use GitHub Copilot in JetBrains IDEs, with Copilot now available in JetBrains Air.",
        "sourceUrl": "https://github.blog/changelog/2026-11-06-github-copilot-weekly-releases-november-2",
        "source": "GitHub Changelog",
        "publishedAt": "2026-11-06T21:00:26.000Z",
        "checkedAt": "2026-11-08T16:39:48.854Z"
      },
      {
        "id": "E6",
        "kind": "body",
        "text": "You can now work with GitHub Copilot directly in Xcode&rsquo;s built-in coding assistant, bringing Copilot into your native Xcode workflow.",
