      {
        "id": "E3",
        "kind": "body",
        "text": "Fleet-wide computer vision model lifecycle management is a problem that shows up the moment a quality inspection proof of concept succeeds.",
        "sourceUrl": "https://aws.amazon.com/blogs/machine-learning/fleet-wide-computer-vision-lifecycle-at-the-edge-with-sagemaker-sdk-v3/",
        "source": "AWS Machine Learning Blog",
