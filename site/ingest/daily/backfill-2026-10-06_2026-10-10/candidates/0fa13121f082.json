      },
      {
        "id": "E4",
        "kind": "body",
        "text": "As AI tools become better and easier to use, having clear context about the content you encounter online helps you make informed decisions about what to trust.",
        "sourceUrl": "https://blog.google/innovation-and-ai/models-and-research/google-deepmind/synth-id-ai-content/",
