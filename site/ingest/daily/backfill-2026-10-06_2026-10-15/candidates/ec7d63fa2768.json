      },
      {
        "id": "E5",
        "kind": "body",
        "text": "The AI Scan tab shows total findings and how many findings include or do not include an autofix suggestion.",
        "sourceUrl": "https://github.blog/changelog/2026-10-13-code-scanning-ai-scan-metrics-in-security-overview",
        "source": "GitHub Changelog",
        "publishedAt": "2026-10-13T12:03:17.000Z",
