      {
        "id": "E4",
        "kind": "body",
        "text": "\"section_header\": \"We’re powering European scientific discovery with advanced AI compute and frontier models.\"",
        "sourceUrl": "https://blog.google/innovation-and-ai/models-and-research/google-deepmind/were-powering-european-scientific-discovery-with-advanced-ai-compute-and-frontier-models/",
        "source": "Google (The Keyword · AI)",
