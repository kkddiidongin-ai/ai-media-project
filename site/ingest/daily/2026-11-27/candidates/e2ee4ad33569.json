        "text": "Verifiable Social Reasoning for LLM Assistants",
        "sourceUrl": "https://research.google/blog/verifiable-social-reasoning-for-llm-assistants/",
        "source": "Google Research Blog",
        "publishedAt": "2026-11-25T17:10:27.000Z",
