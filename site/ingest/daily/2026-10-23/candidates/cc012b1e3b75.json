        "id": "E0",
        "kind": "feed",
        "text": "Anthropic is an AI safety and research company that's working to build reliable, interpretable, and steerable AI systems.",
        "sourceUrl": "https://www.anthropic.com/news/donating-agent-skills-to-the-agentic-ai-foundation",
        "source": "Anthropic",
        "publishedAt": "2026-10-22T00:00:00.000Z",
