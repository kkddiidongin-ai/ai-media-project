        "id": "E1",
        "kind": "body",
        "text": "Genie 4: A new generation of world simulation — Google DeepMind • • • • • • • • • • • • • • • • • • Skip to main content",
        "sourceUrl": "https://deepmind.google/blog/genie-4-a-new-generation-of-world-simulation/",
        "source": "Google DeepMind",
        "publishedAt": "2026-10-27T16:01:38.000Z",
