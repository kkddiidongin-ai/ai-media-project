      },
      {
        "id": "E5",
        "kind": "body",
        "text": "A global ecosystem of computing and infrastructure partners are working with NVIDIA to deliver modular AI factories worldwide in early 2027.",
        "sourceUrl": "https://nvidianews.nvidia.com/news/nvidia-introduces-dsx-pod-ai-factories-to-accelerate-europes-infrastructure-deployment",
        "source": "NVIDIA Newsroom (Press Releases)",
