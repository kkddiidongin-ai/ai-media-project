{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backfill:2026": "node scripts/ingest/run.mjs --mode backfill --from 2026-01-01",
    "ingest:news": "node scripts/ingest/run.mjs --mode incremental",
    "publish:stories": "node scripts/ingest/publish.mjs",
    "qa:content": "node scripts/qa/check-content.mjs",
    "qa:sources": "node scripts/qa/check-sources.mjs",
    "qa:routes": "node scripts/qa/check-routes.mjs",
    "postbuild": "node scripts/postbuild-fix-segments.mjs",
    "publish:daily": "npm run publish:stories && npm run qa:content && npx tsc --noEmit && npm run lint && npm run build && npm run qa:routes",
    "qa:quality": "node scripts/qa/audit-quality.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
