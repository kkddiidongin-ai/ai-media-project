# AI마중 뉴스레터 — 환경변수 이름 목록 (값은 넣지 않는다)
# 로컬: 이 파일을 .env.local로 복사해 값을 채운다 (.env.local은 git에 올라가지 않음)
# 배포: Vercel Project Settings → Environment Variables에 같은 이름으로 넣는다

# [필수·비밀] Resend API 키. 코드·git에 절대 넣지 않는다
RESEND_API_KEY=

# [필수] 구독자를 담을 Resend Segment ID. 이름은 Audience지만 값은 Segment ID (지금은 Resend 'General' Segment). RESEND_SEGMENT_ID로 넣어도 된다
RESEND_AUDIENCE_ID=

# [필수·비밀] 구독 확인 링크 토큰을 암호화·서명하는 비밀값 (32자 이상 무작위). 바꾸면 아직 확인 안 한 링크가 모두 무효가 된다
NEWSLETTER_CONFIRM_SECRET=

# [선택] 발신 주소. 비우면 설정 파일의 letter@aimajung.com (Resend 인증 도메인, vercel.app 주소 불가)
NEWSLETTER_FROM_EMAIL=
# [선택] 발신자 이름 (기본 AI마중)
NEWSLETTER_FROM_NAME=
# [정기 발송 필수] 답장 받을 주소. 실제 받은편지함이 준비된 뒤에만 넣는다 (예정: hello@aimajung.com).
# 비어 있으면 확인 메일은 Reply-To 없이 나가고, newsletter:send는 멈춘다
NEWSLETTER_REPLY_TO=

# [선택] 메일 하단 발행인 정보 (상호·연락처 등)
NEWSLETTER_OPERATOR_INFO=

# [테스트 발송용·로컬만] 테스트 메일을 받을 주소
NEWSLETTER_TEST_TO=
