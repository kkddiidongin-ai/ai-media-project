# AI마중 뉴스레터 — 환경변수 이름 목록 (값은 넣지 않는다)
# 로컬: 이 파일을 .env.local로 복사해 값을 채운다 (.env.local은 git에 올라가지 않음)
# 배포: Vercel Project Settings → Environment Variables에 같은 이름으로 넣는다

# [필수·비밀] Resend API 키. 코드·git에 절대 넣지 않는다
RESEND_API_KEY=

# [필수] 구독자를 담을 Resend Segment ID (예전 이름 Audience ID). RESEND_SEGMENT_ID로 넣어도 된다
RESEND_AUDIENCE_ID=

# [발송 필수] Resend에서 인증한 aimajung.com(또는 그 서브도메인)의 발신 주소 (vercel.app 주소 불가)
NEWSLETTER_FROM_EMAIL=
# [선택] 발신자 이름 (기본 AI마중), 답장 받을 주소
NEWSLETTER_FROM_NAME=
NEWSLETTER_REPLY_TO=

# [선택] 메일 하단 발행인 정보 (상호·연락처 등)
NEWSLETTER_OPERATOR_INFO=

# [테스트 발송용·로컬만] 테스트 메일을 받을 주소
NEWSLETTER_TEST_TO=
